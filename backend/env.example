# E-Time Office Cloud API Configuration
# Copy this file to .env and fill in your actual credentials

# E-Time Office Cloud API Base URL
E_TIME_API_URL=https://api.etimeoffice.com/api

# E-Time Office Cloud Corporate ID
E_TIME_CORPORATE_ID=PrajaKiranaSeva

# E-Time Office Cloud Username
E_TIME_USERNAME=PrajaKiranaSeva

# E-Time Office Cloud Password
E_TIME_PASSWORD=PrajaKS@123

# Server Port (default: 3000)
PORT=3000

# JWT Secret (change this to a random string in production!)
# Use a random string generator for security
JWT_SECRET=your-super-secret-random-string-change-this-123456
